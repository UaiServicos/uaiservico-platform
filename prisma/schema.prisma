generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  phone            String?
  name             String
  password         String
  userType         UserType         @default(CLIENT)
  avatar           String?
  lastLogin        DateTime?
  lastActivity     DateTime?
  lastLogout       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bookings         Booking[]
  clientProfile    ClientProfile?
  comments         Comment[]
  followers        Follow[]         @relation("UserFollowers")
  following        Follow[]         @relation("UserFollowing")
  receivedMessages Message[]        @relation("MessageReceiver")
  sentMessages     Message[]        @relation("MessageSender")
  postLikes        PostLike[]
  posts            Post[]
  providerProfile  ProviderProfile?
  reviews          Review[]
  clientContacts   Contact[]        @relation("ClientContacts")

  @@map("users")
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String?
  city      String?
  state     String?
  zipCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ProviderProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  description         String?
  experience          Int?
  experienceUnit      String?              // "months" ou "years"
  verified            Boolean              @default(false)
  active              Boolean              @default(true)
  address             String?
  city                String
  state               String
  zipCode             String?
  serviceRadius       Int?
  businessName        String?
  document            String?
  hourlyRate          Float?
  dailyRate           Float?
  averageJobValue     Float?               // Valor médio do trabalho
  averageJobValueUnit String?              // "hour" ou "day"
  rating              Float?
  totalReviews        Int                  @default(0)
  totalJobs           Int                  @default(0)
  responseTime        Int?
  subscriptionId      String?
  subscriptionEndsAt  DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  serviceAreas        String?
  serviceCities       String?
  availabilities      Availability[]
  bookings            Booking[]
  portfolios          Portfolio[]
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  services            ProviderService[]
  receivedReviews     Review[]             @relation("ProviderReviews")
  whatsappIntegration WhatsAppIntegration?
  contacts            Contact[]            @relation("ProviderContacts")
  formations          Formation[]          @relation("ProviderFormations")

  @@map("provider_profiles")
}

model Formation {
  id                String          @id @default(cuid())
  providerId        String
  institutionName   String          // Nome da instituição
  area              String          // Área de formação
  certificateUrl    String?         // URL do certificado anexado
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  provider          ProviderProfile @relation("ProviderFormations", fields: [providerId], references: [id], onDelete: Cascade)

  @@map("formations")
}

model ServiceCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  icon        String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  services    ProviderService[]

  @@map("service_categories")
}

model ProviderService {
  id          String          @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String?
  price       Float?
  priceType   PriceType       @default(FIXED)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_services")
}

model Portfolio {
  id          String          @id @default(cuid())
  providerId  String
  title       String
  description String?
  images      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model Availability {
  id         String          @id @default(cuid())
  providerId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model Booking {
  id            String          @id @default(cuid())
  clientId      String
  providerId    String
  serviceId     String
  title         String
  description   String?
  scheduledAt   DateTime
  address       String
  agreedPrice   Float?
  status        BookingStatus   @default(PENDING)
  clientPhone   String?
  providerPhone String?
  whatsappLink  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  service       ProviderService @relation(fields: [serviceId], references: [id])
  provider      ProviderProfile @relation(fields: [providerId], references: [id])
  client        User            @relation(fields: [clientId], references: [id])
  messages      Message[]

  @@map("bookings")
}

model Message {
  id         String      @id @default(cuid())
  bookingId  String
  senderId   String
  receiverId String
  content    String
  type       MessageType @default(TEXT)
  readAt     DateTime?
  createdAt  DateTime    @default(now())
  receiver   User        @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender     User        @relation("MessageSender", fields: [senderId], references: [id])
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Contact {
  id         String   @id @default(cuid())
  clientId   String
  providerId String
  contactedAt DateTime @default(now())
  canReview  Boolean  @default(true)
  reviewedAt DateTime?
  client     User     @relation("ClientContacts", fields: [clientId], references: [id])
  provider   ProviderProfile @relation("ProviderContacts", fields: [providerId], references: [id])
  review     Review?

  @@unique([clientId, providerId])
  @@map("contacts")
}

model Review {
  id         String          @id @default(cuid())
  contactId  String          @unique
  reviewerId String
  providerId String
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  provider   ProviderProfile @relation("ProviderReviews", fields: [providerId], references: [id])
  reviewer   User            @relation(fields: [reviewerId], references: [id])
  contact    Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Subscription {
  id                String            @id @default(cuid())
  name              String
  description       String?
  price             Float
  duration          Int
  features          String
  maxServices       Int?
  maxPortfolioItems Int?
  prioritySupport   Boolean           @default(false)
  verifiedBadge     Boolean           @default(false)
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  providers         ProviderProfile[]

  @@map("subscriptions")
}

model WhatsAppIntegration {
  id          String          @id @default(cuid())
  providerId  String          @unique
  phoneNumber String
  apiKey      String?
  webhookUrl  String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("whatsapp_integrations")
}

model Post {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  content     String?
  images      String?
  serviceType String?
  location    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    Comment[]
  postLikes   PostLike[]
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

enum PriceType {
  FIXED
  HOURLY
  DAILY
  NEGOTIABLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
  CONTACT
}

enum UserType {
  CLIENT
  PROVIDER
}
